# ==============================================================================
# DRIPTIDE — API SERVER ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is gitignored.
# ==============================================================================

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Supabase (Server-side ONLY — never expose to browser) ──────────────────────
# Get these from: https://supabase.com → Your Project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here
# Get from: Supabase → Your Project → Settings → Auth → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ── CORS ───────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── SMTP — Transactional Email ─────────────────────────────────────────────────
# Recommended provider: Resend (https://resend.com) — free tier: 3,000 emails/month
#
# Resend SMTP settings:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASS=re_your_api_key_here      ← from Resend dashboard → API Keys
#
# Gmail SMTP settings (use an App Password — not your account password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-16-char-app-password ← Google Account → Security → App Passwords
#
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here
SMTP_FROM_EMAIL=orders@yourdomain.com
SMTP_FROM_NAME=Driptide
