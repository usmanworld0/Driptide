# ==============================================================================
# DRIPTIDE — NEXT.JS FRONTEND ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local — it is gitignored.
# ==============================================================================

# ── API Backend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ── Supabase (browser-safe keys ONLY) ─────────────────────────────────────────
# These keys are intentionally public — they only grant limited anon access
# controlled by your Row Level Security policies.
# Get from: https://supabase.com → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
