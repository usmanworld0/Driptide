# ==============================================================================
# DRIPTIDE E-COMMERCE PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (apps/web)
# ------------------------------------------------------------------------------
# Authoritative API backend URL
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Supabase Public Anonymous credentials (Safe for browser client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (apps/api)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=production

# Supabase Server-Side Private Credentials (NEVER expose to browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-secret...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Permitted CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://driptide.com

# ------------------------------------------------------------------------------
# OPTIONAL INTEGRATIONS (PAYMENTS & TRANSACTIONAL NOTIFICATIONS)
# ------------------------------------------------------------------------------
# Stripe API Keys (Provider abstraction defaults to local mock in dev)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Transactional Email SMTP
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_...
SMTP_FROM_EMAIL=concierge@driptide.com
